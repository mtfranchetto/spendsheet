{
  "name": "spendsheet",
  "version": "0.1.0",
  "description": "Sync bank transactions into Google Sheets via open banking (PSD2). Free, no server, no subscription.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "node tests/preview.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "push": "clasp push",
    "push:watch": "clasp push --watch",
    "pull": "clasp pull",
    "status": "clasp status",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "open-banking",
    "psd2",
    "google-sheets",
    "google-apps-script",
    "personal-finance",
    "enable-banking"
  ],
  "author": "Mattia Franchetto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtfranchetto/spendsheet.git"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
