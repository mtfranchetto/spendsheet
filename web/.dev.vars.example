# Copy to `.dev.vars` — gitignored, because the client secret and the session
# key below are credentials and this repo is meant to go public.
#
#   cp .dev.vars.example .dev.vars
#
# `wrangler dev` reads this file and hands it to the Worker as `env`. The names
# match `Env` in `worker/router.ts` exactly; a typo shows up as `/api/health`
# reporting that binding as missing, which is why it reports them one by one.
# Deployed, each of these is a `wrangler secret put <NAME>` instead.

# From the OAuth client (Web application) in the Google Cloud console. Its
# authorised redirect URIs must include  http://localhost:8787/auth/callback
# for local development, alongside the deployed origin's /auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes of base64. Seals every cookie; rotating it signs every device out.
#   openssl rand -base64 32
SESSION_KEY=

# Google account IDs allowed in, comma-separated. Leave empty on the first run:
# sign in, read your ID off the refusal, put it here, sign in again.
ALLOWED_ACCOUNTS=

# The book, from its URL: docs.google.com/spreadsheets/d/<THIS>/edit
SPREADSHEET_ID=

# For /connect's Picker. The API key is restricted in the console to this origin
# and the Picker API; the project number is on the Cloud project's dashboard.
PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
