{
  "name": "spendsheet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Spendsheet viewer: a static Solid app and one Worker in front of /api, /auth and /connect.",
  "scripts": {
    "tools": "./scripts/tools.sh",
    "tools:install": "./scripts/tools.sh install",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "wrangler dev",
    "deploy": "vite build && wrangler deploy --var BUILD_SHA:$(git rev-parse --short HEAD) && node scripts/accounts.mjs ensure",
    "accounts": "node scripts/accounts.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.10",
    "solid-js": "2.0.0-rc.10"
  }
}
