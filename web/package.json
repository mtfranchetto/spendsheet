{
  "name": "spendsheet-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The Spendsheet viewer: a static Solid app and one Worker in front of /api, /auth and /connect.",
  "scripts": {
    "tools": "../scripts/tools.sh",
    "tools:install": "../scripts/tools.sh install",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "wrangler dev",
    "predeploy": "npm run typecheck && npm --prefix .. test",
    "deploy": "vite build && wrangler deploy --var BUILD_SHA:$(git rev-parse --short HEAD) && node scripts/accounts.mjs ensure",
    "accounts": "node scripts/accounts.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "solid-js": "2.0.0-rc.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
